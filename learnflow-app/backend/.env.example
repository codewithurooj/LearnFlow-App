# ============================================================
# LearnFlow Backend - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# Service Identification
# ------------------------------------------------------------
SERVICE_NAME=learnflow-service
SERVICE_VERSION=1.0.0
ENVIRONMENT=development            # development | staging | production

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ------------------------------------------------------------
# OpenAI (REQUIRED)
# ------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TIMEOUT=30

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DATABASE_URL=postgresql://learnflow:learnflow@localhost:5432/learnflow
NEON_DATABASE_URL=                      # e.g. postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/learnflow?sslmode=require
USE_NEON=false                          # set to true in production to use Neon

# ------------------------------------------------------------
# Dapr Sidecar
# ------------------------------------------------------------
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
DAPR_PUBSUB_NAME=pubsub-kafka
DAPR_STATESTORE_NAME=statestore-postgres

# ------------------------------------------------------------
# Kafka Topics
# ------------------------------------------------------------
TOPIC_LEARNING_QUESTIONS=learning.questions
TOPIC_LEARNING_RESPONSES=learning.responses
TOPIC_CODE_SUBMISSIONS=code.submissions
TOPIC_CODE_RESULTS=code.results
TOPIC_STRUGGLE_DETECTED=struggle.detected
TOPIC_PROGRESS_UPDATED=progress.updated

# ------------------------------------------------------------
# Code Execution Sandbox
# ------------------------------------------------------------
CODE_EXECUTION_TIMEOUT=5           # seconds
CODE_MEMORY_LIMIT_MB=50            # megabytes

# ------------------------------------------------------------
# Struggle Detection Thresholds
# ------------------------------------------------------------
STRUGGLE_ERROR_THRESHOLD=3         # same error type N times
STRUGGLE_STUCK_MINUTES=10          # stuck on exercise > N min
STRUGGLE_LOW_SCORE_THRESHOLD=0.5   # quiz score < 50%
STRUGGLE_FAILURE_THRESHOLD=5       # N failed executions in a row

# ------------------------------------------------------------
# Mastery Calculation Weights (must sum to 1.0)
# ------------------------------------------------------------
MASTERY_WEIGHT_EXERCISES=0.4
MASTERY_WEIGHT_QUIZZES=0.3
MASTERY_WEIGHT_CODE_QUALITY=0.2
MASTERY_WEIGHT_STREAK=0.1

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                    # json | text
