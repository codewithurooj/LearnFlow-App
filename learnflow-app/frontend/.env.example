NEXT_PUBLIC_DEBUG_URL=http://localhost:8004
NEXT_PUBLIC_EXERCISE_URL=http://localhost:8005
NEXT_PUBLIC_PROGRESS_URL=http://localhost:8006
NEXT_PUBLIC_CODE_REVIEW_URL=http://localhost:8007
NEXT_PUBLIC_MCP_CONTEXT_URL=http://localhost:8008
